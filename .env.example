# Environment Configuration

# Database
DATABASE_URL=postgresql://localhost/atis_node_builder

# LLM Provider (Mistral)
MISTRAL_API_KEY=FylBZIN5YxypyCBwaH42rwSxp8Xicupz
MISTRAL_MODEL=labs-leanstral-1-5

# Google Sheets (private, authenticated ENTITY_RAW input)
# Production: use Workload Identity Federation / external account credentials.
# Do not use a service-account private key or a Google API key for private-sheet access.
GOOGLE_AUTH_MODE=WORKLOAD_IDENTITY_FEDERATION
GOOGLE_PROJECT_ID=nora-production-509012
GOOGLE_WORKLOAD_IDENTITY_PROVIDER=projects/123456789/locations/global/workloadIdentityPools/nora-pool/providers/nora-provider
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=nora-sheets-reader@nora-production-509012.iam.gserviceaccount.com
GOOGLE_SHEETS_SPREADSHEET_ID=1C2fgbxQaU0uql-e62bmx5e06xMDnEc-hWIHvLYndI3A
GOOGLE_SHEETS_WORKSHEET_NAME=ENTITY_RAW
# Optional: local ADC/external-account config for developer testing only.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/external-account-config.json
# Do not store static service-account private keys or JSON service-account data in Git.
# GOOGLE_SERVICE_ACCOUNT_INFO={"type":"service_account",...}

# Logging
LOG_LEVEL=INFO

# Research
SEARCH_TIMEOUT=30
MAX_SOURCES_PER_QUERY=10

# Entity Resolution
FUZZY_MATCH_THRESHOLD=0.85

# Job Processing
MAX_CONCURRENT_JOBS=5
JOB_TIMEOUT_SECONDS=3600
